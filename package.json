{
  "name": "storage-layout-action",
  "version": "0.1.0",
  "private": true,
  "description": "GitHub action to track storage layouts of upgradeable Solidity contracts in Foundry projects and block incompatible changes",
  "main": "dist/index.cjs",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --target=node20 --format=cjs --external:@nomicfoundation/slang --external:'@nomicfoundation/slang/*' --outfile=dist/index.cjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format:check": "prettier --check 'src/**/*.ts' 'test/**/*.ts'",
    "format:write": "prettier --write 'src/**/*.ts' 'test/**/*.ts'"
  },
  "author": "Michalis Kargakis",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xmichalis/storage-layout-action.git"
  },
  "keywords": [
    "actions",
    "conflicts",
    "contracts",
    "foundry",
    "forge",
    "layout",
    "solidity",
    "storage",
    "upgradeable"
  ],
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.6.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@openzeppelin/upgrades-core": "^1.46.0"
  },
  "overrides": {
    "bn.js": "^5.2.3",
    "secp256k1": "^4.0.4",
    "elliptic": {
      ".": "^6.6.1",
      "bn.js": "^4.12.3"
    }
  }
}
